[
  {
    "model": "sbam_app.dimension",
    "pk": 1,
    "fields": {
      "title": "Assets",
      "description": "This dimension refers to organization's assets (including people, buildings, machines, systems and information assets) and includes policies that enforce several levels of confidentiality, availability, and integrity controls.",
      "level": 0
    }
  },
  {
    "model": "sbam_app.dimension",
    "pk": 2,
    "fields": {
      "title": "Continuity",
      "description": "This dimension is meant to ensure operations, services and production continuity for an organization at predefined levels while safeguarding the reputation and interests of key stakeholders in cases of disruptive incidents.",
      "level": 0
    }
  },
  {
    "model": "sbam_app.dimension",
    "pk": 3,
    "fields": {
      "title": "Access and Trust",
      "description": "This dimension focuses on appropriate access to resources across the organization while clarifying different roles and permissions. In addition, it delimits any interactions the organization has with third-party factors, such as suppliers, customers, authorities, and so on.",
      "level": 0
    }
  },
  {
    "model": "sbam_app.dimension",
    "pk": 4,
    "fields": {
      "title": "Operations",
      "description": "This dimension refers to the administration of business practices to create the highest level of efficiency possible within an organization while taking into account the security aspects that safeguard its final results.",
      "level": 0
    }
  },
  {
    "model": "sbam_app.dimension",
    "pk": 5,
    "fields": {
      "title": "Defense",
      "description": "This dimension focuses on the foresight to have planned, acquired and properly configured all technical assets necessary for the improvement and efficient operation of its information security.",
      "level": 0
    }
  },
  {
    "model": "sbam_app.dimension",
    "pk": 6,
    "fields": {
      "title": "Security Governance",
      "description": "This dimension refers to the measures taken to effectively plan, manage and improve its information security.",
      "level": 0
    }
  },
  {
    "model": "sbam_app.dimension",
    "pk": 7,
    "fields": {
      "title": "Attitude",
      "description": "This dimension refers to the feelings and beliefs employees have toward security protocols and issues.",
      "level": 1
    }
  },
  {
    "model": "sbam_app.dimension",
    "pk": 8,
    "fields": {
      "title": "Awareness",
      "description": "This dimension examines employees' understanding, knowledge and awareness of security issues and activities.",
      "level": 1
    }
  },
  {
    "model": "sbam_app.dimension",
    "pk": 9,
    "fields": {
      "title": "Behaviour",
      "description": "This dimension assists in studying the security-conscious behaviour exhibited on a day-to-day basis in an individual's workplace.",
      "level": 1
    }
  },
  {
    "model": "sbam_app.dimension",
    "pk": 10,
    "fields": {
      "title": "Competency",
      "description": "This dimension refers to evaluating the employees' abilities, skills, knowledge and expertise that enable them to conform with the security policies and procedures of the organization.",
      "level": 1
    }
  },

# Django settings
DJANGO_SETTINGS_MODULE=sbam.settings.settings
DJANGO_DEVELOPMENT=False
### Fill in your secret key below
SECRET_KEY=YOUR-SECRET-KEY
DEBUG=off
DJANGO_ALLOWED_HOSTS=*
TIME_ZONE=UTC
LANGUAGE_CODE=en-us

# Django admins
ADMINS=admin admin admin@mysite.com


# Django DB (postgres) settings
SQL_ENGINE=django.db.backends.postgresql
SQL_DATABASE=db_name
SQL_USER=db_user
SQL_PASSWORD=db_user_password
SQL_HOST=db
SQL_PORT=5432


# Email settings
EMAIL_HOST='email-host'
EMAIL_PORT=email-port
EMAIL_HOST_USER=email-host-user
EMAIL_HOST_PASSWORD=email-host-password
EMAIL_USE_TLS=True

ENCRYPTED_ENDPOINT=encrypted_link

# Gunicorn
# ------------------------------------------------------------------------------
WEB_CONCURRENCY=3
